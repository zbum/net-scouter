[Unit]
Description=net-scouter eBPF network flow discovery agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Linux 4.18 has no CAP_BPF. Staying root keeps one unit valid on Rocky 8.10 and Ubuntu 22.04.
ExecStart=/usr/local/bin/net-scouter run --config /etc/net-scouter/net-scouter.yaml
RuntimeDirectory=net-scouter
RuntimeDirectoryMode=0700
StateDirectory=net-scouter
StateDirectoryMode=0700
LimitMEMLOCK=infinity
# Flow JSON is available through the query socket, metrics, or persistent DB.
# Never forward legacy stdout export to journald/rsyslog.
StandardOutput=null
StandardError=journal
SyslogIdentifier=net-scouter
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
